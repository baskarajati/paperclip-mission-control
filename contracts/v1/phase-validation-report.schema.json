{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/baskarajati/paperclip-mission-control/contracts/v1/phase-validation-report.schema.json",
  "title": "Phase validation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "missionId", "phaseId", "reportRevisionId", "assertionResults"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion1" },
    "missionId": { "$ref": "common.schema.json#/$defs/stableId" },
    "phaseId": { "$ref": "common.schema.json#/$defs/stableId" },
    "reportRevisionId": { "$ref": "common.schema.json#/$defs/paperclipId" },
    "assertionResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertionId", "status"],
        "properties": {
          "assertionId": { "$ref": "common.schema.json#/$defs/assertionIdRef" },
          "status": {
            "enum": ["pass", "fail", "waived", "blocked"]
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/$defs/paperclipId" }
          }
        }
      }
    }
  }
}
