{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/baskarajati/paperclip-mission-control/contracts/v1/phase-plan.schema.json",
  "title": "Phase plan",
  "description": "Mission phase intent. A human confirmation and a transition key both bind this document's revision, so it must never carry derived state. Derived phase state lives in the plugin database. See issue #8.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "missionId", "planRevisionId", "phases"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion1" },
    "missionId": { "$ref": "common.schema.json#/$defs/stableId" },
    "planRevisionId": { "$ref": "common.schema.json#/$defs/paperclipId" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phaseId", "objective"],
        "properties": {
          "phaseId": { "$ref": "common.schema.json#/$defs/stableId" },
          "objective": { "$ref": "common.schema.json#/$defs/humanSummary" },
          "validationContractRef": { "$ref": "common.schema.json#/$defs/stableId" }
        }
      }
    }
  }
}
