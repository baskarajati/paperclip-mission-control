{
  "name": "paperclip-mission-control",
  "version": "0.0.0",
  "private": true,
  "description": "Repository-owned v1 data contracts and executable semantic validation for Paperclip Mission Control.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "pnpm --filter @paperclip-mission-control/plugin build",
    "typecheck": "pnpm --filter @paperclip-mission-control/plugin typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm test:contracts && pnpm test:tooling && pnpm test:package && pnpm --filter @paperclip-mission-control/plugin test",
    "test:contracts": "node --test \"tests/contracts/*.test.mjs\"",
    "test:tooling": "node --test \"tests/tooling/*.test.mjs\"",
    "test:package": "pnpm build && node --test \"tests/package/*.test.mjs\"",
    "verify:package": "node scripts/verify-package.mjs",
    "test:real-loader": "node --test \"tests/conformance/real-loader.test.mjs\"",
    "verify:no-runtime-deps": "node scripts/verify-no-runtime-dependencies.mjs",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm verify:package && pnpm verify:no-runtime-deps"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "typescript-eslint": "8.67.0"
  }
}
