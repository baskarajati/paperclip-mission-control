{
  "name": "paperclip-mission-control",
  "version": "0.0.0",
  "private": true,
  "description": "Repository-owned v1 data contracts and executable semantic validation for Paperclip Mission Control.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "pnpm --filter @paperclip-mission-control/plugin build",
    "typecheck": "pnpm --filter @paperclip-mission-control/plugin typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm test:contracts && pnpm --filter @paperclip-mission-control/plugin test",
    "test:contracts": "node --test \"tests/contracts/*.test.mjs\"",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "verify:no-runtime-deps": "node scripts/verify-no-runtime-dependencies.mjs",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm verify:no-runtime-deps && pnpm audit:prod"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "typescript-eslint": "8.67.0"
  }
}
